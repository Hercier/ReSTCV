obj = TriangleMesh.createFromFile('models/Mesh000_Pot1.obj')
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Pot1Lid', Transform()),
    sceneBuilder.addTriangleMesh(obj, Pot1)
